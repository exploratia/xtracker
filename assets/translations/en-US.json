        "title": "Day Check",
        "info": "Track per-day checks – even if some days stay empty. Useful for things like exercise, taking breaks or skipping sweets."
      },
      "dailyLife": {
        "title": "Daily Life",
        "info": "Tag each day with an attribute – e.g. type of sport or mood.\n\nThis helps reflect on the day and gives an overview of patterns and ratios over time."
      },
      "habit": {
        "title": "Habit",
        "info": "Track habits multiple times a day – e.g. coffee consumption or drinking enough water.\nIdeal for routines you want to build or reduce."
      },
      "custom": {
        "title": "Custom",
        "info": "Track custom data with one or multiple parameters per entry – e.g. refueling distance and cost."
      },
      "monthly": {
        "title": "Monthly",
        "info": "Track custom monthly data with one or multiple parameters per entry – e.g. water or current consumption to see the yearly progress.\n\nEntries made before mid-month still count for the previous month. Example: Water consumption for January can only be read at the beginning of February – maybe even on February 4 if you're not home earlier."
      }
